const KS='catalogo-sync',GF='catalogo.json';
let sync={};try{sync=JSON.parse(localStorage.getItem(KS))||{}}catch(e){}
const salvaSync=()=>{try{localStorage.setItem(KS,JSON.stringify(sync))}catch(e){aviso('Não foi possível salvar a configuração da nuvem.',5000)}};
const gid=s=>((s||'').match(/[0-9a-f]{20,40}/i)||[''])[0];
const fdata=s=>new Date(s).toLocaleString('pt-BR',{dateStyle:'short',timeStyle:'short'});
const hdb=()=>{const t=JSON.stringify(db.atrizes);let x=5381;for(let k=0;k<t.length;k++)x=(x*33^t.charCodeAt(k))>>>0;return x+'.'+t.length};
const sincInfo=()=>{$('#sinc').textContent=sync.ultima?'Nuvem: '+fdata(sync.ultima):sync.gist?'Nuvem: ainda não sincronizado':''};
async function gh(path,op={}){let r;
 try{r=await fetch('https://api.github.com'+path,{cache:'no-store',...op,headers:{Accept:'application/vnd.github+json',...(sync.token?{Authorization:'Bearer '+sync.token}:{}),...(op.body?{'Content-Type':'application/json'}:{})}})}
 catch(e){throw 'Sem conexão com a internet (ou o GitHub está inacessível).'}
 if(r.ok)return r.json();
 throw r.status===401?'Token inválido ou expirado. Abra ⚙ para corrigir (ou apague o token para baixar só com o ID).':r.status===404?'Gist não encontrado. Confira o ID (e o token, se o gist for seu).':r.status===403||r.status===429?'O GitHub recusou: limite de requisições atingido ou token sem a permissão "gist".':'Erro do GitHub ('+r.status+').'}
async function cfgNuvem(){
 const r=await form('Nuvem (GitHub Gist)',[
  {k:'tk',l:'Token do GitHub, só com permissão "gist" (fica apenas neste aparelho; apague para remover)',v:sync.token,t:'password',ph:'ghp_...'},
  {k:'id',l:'ID do gist (em branco = criar um novo ao enviar)',v:sync.gist,ph:'Cole o ID ou o endereço do gist'}]);
 if(!r)return false;const g=gid(r.id);
 if(r.id&&!g){aviso('ID do gist inválido',5000);return false}
 if(g!==(sync.gist||'')){delete sync.remoto;delete sync.ultima;delete sync.hash}
 if(r.tk)sync.token=r.tk;else delete sync.token;
 if(g)sync.gist=g;else delete sync.gist;
 salvaSync();sincInfo();return true}
async function enviar(){
 if(!sync.token&&!await cfgNuvem())return;
 if(!sync.token){aviso('Informe o token do GitHub para enviar.',5000);return}
 const corpo=JSON.stringify(db);let d;
 if(sync.gist){
  const g=await gh('/gists/'+sync.gist);
  if(g.updated_at!==sync.remoto&&!confirm(sync.remoto?'A nuvem foi alterada depois da última sincronização feita neste aparelho (nuvem: '+fdata(g.updated_at)+').\n\nEnviar vai SOBRESCREVER essas alterações. Continuar?':'Este aparelho ainda não sincronizou com esse gist e ele já tem conteúdo.\n\nEnviar vai SOBRESCREVER a nuvem. Continuar?'))return;
  d=await gh('/gists/'+sync.gist,{method:'PATCH',body:JSON.stringify({files:{[GF]:{content:corpo}}})})}
 else d=await gh('/gists',{method:'POST',body:JSON.stringify({description:'Catálogo (backup)',public:false,files:{[GF]:{content:corpo}}})});
 Object.assign(sync,{gist:d.id,remoto:d.updated_at,ultima:new Date().toISOString(),hash:hdb()});salvaSync();sincInfo();aviso('Catálogo enviado para a nuvem')}
async function baixar(){
 if(!sync.gist&&!await cfgNuvem())return;
 if(!sync.gist){aviso('Informe o ID do gist para baixar.',5000);return}
 const g=await gh('/gists/'+sync.gist),f=g.files&&g.files[GF];
 if(!f){aviso('O gist não tem o arquivo '+GF,5000);return}
 let t=f.content;
 if(f.raw_url){try{const r=await fetch(f.raw_url,{cache:'no-store'});if(!r.ok)throw 0;t=await r.text()}catch(e){if(f.truncated||!t)throw 'Não foi possível baixar o arquivo da nuvem.'}}
 let d;try{d=JSON.parse(t)}catch(e){}
 if(!d||!Array.isArray(d.atrizes)){aviso('O arquivo da nuvem não é um catálogo válido',5000);return}
 if(!confirm('Baixar vai SUBSTITUIR o catálogo deste aparelho pelo da nuvem (atualizado em '+fdata(g.updated_at)+').'+(db.atrizes.length&&sync.hash!==hdb()?'\n\nATENÇÃO: este aparelho tem alterações que não foram enviadas para a nuvem e serão perdidas.':'')+'\n\nContinuar?'))return;
 const cfg=db.cfg;db=d;db.cfg=cfg;salvar();aplicar();
 Object.assign(sync,{remoto:g.updated_at,ultima:new Date().toISOString(),hash:hdb()});salvaSync();sincInfo();
 location.hash='#/';ir();aviso('Catálogo baixado da nuvem')}
