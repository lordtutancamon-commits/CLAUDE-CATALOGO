async function nova(){const r=await form('Nova atriz',[{k:'nome',l:'Nome'},{k:'capa',l:'Link da imagem de capa',ph:'https://...'},{k:'tags',l:'Tags (separadas por vírgula)'}]);
 if(!r||!r.nome)return;const a={id:uid(),nome:r.nome,capa:r.capa,tags:parseTags(r.tags),secoes:[{id:uid(),titulo:'Geral',itens:[]}]};db.atrizes.push(a);salvar();location.hash='#/a/'+a.id}
async function editar(a){const r=await form('Editar atriz',[{k:'nome',l:'Nome',v:a.nome},{k:'capa',l:'Link da imagem de capa',v:a.capa},{k:'tags',l:'Tags (separadas por vírgula)',v:(a.tags||[]).join(', ')}]);
 if(!r||!r.nome)return;Object.assign(a,{nome:r.nome,capa:r.capa,tags:parseTags(r.tags)});salvar();pagina(a)}
async function novaSecao(a){const r=await form('Nova seção',[{k:'t',l:'Nome da seção',ph:'Ex.: Ensaio 2024'}],'Criar');if(!r||!r.t)return;const it=/https?:\/\//.test(r.t)?analisar(r.t):[];a.secoes.push({id:uid(),titulo:it.length?'Geral':r.t,itens:it});salvar();pagina(a)}
async function addLinks(a,s){const r=await form('Adicionar links',[{k:'t',l:'Cole links de fotos e vídeos ou códigos de embed (vários de uma vez)',area:1,ph:'https://...'},{k:'modo',l:'Links que o programa não reconhece',sel:[['auto','Automático: tenta foto, depois vídeo, depois página incorporada'],['img','Tratar como foto'],['video','Tratar como arquivo de vídeo'],['iframe','Tratar como página incorporada (iframe)']]}],'Adicionar');if(!r||!r.t)return;
 const ex=new Set(a.secoes.flatMap(x=>x.itens.map(i=>i.url))),novos=analisar(r.t).map(i=>i.tipo==='auto'&&r.modo!=='auto'?{...i,tipo:r.modo}:i).filter(i=>!ex.has(i.url));
 s.itens.push(...novos);salvar();pagina(a);aviso(novos.length?novos.length+' item(ns) adicionado(s)':'Nenhum link novo encontrado')}
function range(l,k,min,max){return h('label',{className:'rg'},l,h('input',{type:'range',min,max,value:db.cfg[k],on:{input:e=>{db.cfg[k]=+e.target.value;aplicar()},change:salvar}}))}
function pagina(a){
 const fotos=a.secoes.flatMap(s=>s.itens.filter(i=>i.tipo==='img'));
 trocar(
  h('div',{className:'topo'},h('button',{on:{click:()=>location.hash='#/'}},'‹ Voltar'),h('h2',null,a.nome),h('div',{className:'tags'},(a.tags||[]).map(t=>h('span',{className:'tag'},t))),h('span',{className:'esp'}),
   h('button',{on:{click:()=>editar(a)}},'Editar'),
   h('button',{className:'x',on:{click:()=>{if(confirm('Excluir '+a.nome+' e todo o conteúdo?')){db.atrizes=db.atrizes.filter(x=>x!==a);salvar();location.hash='#/'}}}},'Excluir')),
