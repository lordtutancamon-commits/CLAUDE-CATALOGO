function form(titulo,campos,ok='Salvar'){return new Promise(res=>{
 const d=h('dialog',{className:'dlg'}),f=h('form',{method:'dialog'});
 const ins=campos.map(c=>{const p={value:c.v||'',placeholder:c.ph||'',name:c.k};if(c.area)p.rows=8;if(c.t){p.type=c.t;p.autocomplete='off'}return c.sel?h('select',{name:c.k},c.sel.map(([v,t])=>h('option',{value:v},t))):h(c.area?'textarea':'input',p)});
 f.append(h('h3',null,titulo),...campos.flatMap((c,i)=>[h('label',null,c.l),ins[i]]),h('div',{className:'acoes'},h('button',{type:'button',on:{click:()=>d.close()}},'Cancelar'),h('button',{className:'p',type:'submit'},ok)));
 f.addEventListener('submit',()=>res(Object.fromEntries(campos.map((c,i)=>[c.k,ins[i].value.trim()]))));
 d.addEventListener('close',()=>{d.remove();res(null)});
 d.append(f);document.body.append(d);d.showModal();ins[0].focus()})}
function analisar(t){const vistos=new Set(),out=[],fr=[];
 t=t.replace(/<script[\s\S]*?<\/script>/gi,' ').replace(/<blockquote[^>]*twitter-tweet[\s\S]*?<\/blockquote>/gi,b=>{const m=b.match(/status\/(\d+)/);return m?' https://x.com/i/status/'+m[1]+' ':' '});
 t=t.replace(/<iframe[^>]*?\ssrc=["']([^"']+)["'][^>]*>/gi,(_,s)=>{s=s.startsWith('//')?'https:'+s:s;fr.push(s);return ' '+s+' '});
 for(let u of t.match(/https?:\/\/[^\s"'<>]+/g)||[]){u=u.replace(/[).,;]+$/,'');let c,m;if(/\.(js|css)(\?|#|$)/i.test(u))continue;
  if(m=u.match(/\/\/(?:www\.|mobile\.)?(?:twitter|x)\.com\/[^\/\s]+\/status\/(\d+)/i))c={tipo:'iframe',tw:true,url:'https://platform.twitter.com/embed/Tweet.html?dnt=true&theme=dark&id='+m[1]};
  else
  if(m=u.match(/redgifs\.com\/(?:watch|ifr)\/([a-z0-9]+)/i))c={tipo:'iframe',url:'https://www.redgifs.com/ifr/'+m[1].toLowerCase()};
  else if(m=u.match(/(?:youtube\.com\/(?:watch\?(?:[^#]*&)?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{11})/))c={tipo:'iframe',url:'https://www.youtube.com/embed/'+m[1]};
  else if(m=u.match(/vimeo\.com\/(?:video\/)?(\d+)/))c={tipo:'iframe',url:'https://player.vimeo.com/video/'+m[1]};
  else if(m=u.match(/streamable\.com\/(?:e\/)?([a-z0-9]+)/i))c={tipo:'iframe',url:'https://streamable.com/e/'+m[1]};
  else if(m=u.match(/dailymotion\.com\/(?:embed\/)?video\/(\w+)/i))c={tipo:'iframe',url:'https://www.dailymotion.com/embed/video/'+m[1]};
  else if(/\.(mp4|webm|mov|m4v|ogv|m3u8)(\?|#|$)/i.test(u))c={tipo:'video',url:u};
  else if(/\.(jpe?g|png|gif|webp|avif|bmp|svg)(\?|#|$)/i.test(u))c={tipo:'img',url:u};
  else c={tipo:fr.includes(u)?'iframe':'auto',url:u};
  if(!vistos.has(c.url)){vistos.add(c.url);out.push({id:uid(),v:false,...c})}}
 return out}
let busca='',tagSel='';
function ir(){if(location.hash==='#/fotos'){galeria();scrollTo(0,0);return}const m=location.hash.match(/^#\/a\/(\w+)/),a=m&&db.atrizes.find(x=>x.id===m[1]);a?pagina(a):inicio();scrollTo(0,0)}
addEventListener('hashchange',ir);
const trocar=(...n)=>$('main').replaceChildren(...n.flat().filter(Boolean));
let emb=false,mostrar='todos';
function galeria(){
 const ts=[...new Set(db.atrizes.flatMap(a=>a.tags||[]))].sort();
 if(tagSel&&!ts.includes(tagSel))tagSel='';
 const sel=db.atrizes.filter(a=>(!tagSel||(a.tags||[]).includes(tagSel))&&a.nome.toLowerCase().includes(busca.toLowerCase())).sort((a,b)=>a.nome.localeCompare(b.nome));
 const pegar=f=>sel.flatMap(a=>a.secoes.flatMap(s=>s.itens.filter(i=>http(i.url)&&f(i)).map(i=>({a,i}))));
 const ord=mostrar==='videos'?[]:pegar(i=>i.tipo==='img'),vids=mostrar==='fotos'?[]:pegar(i=>i.tipo==='iframe'||i.tipo==='video');
 const emba=l=>{for(let k=l.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[l[k],l[j]]=[l[j],l[k]]}};
 if(emb){emba(ord);emba(vids)}
 const lista=ord.map(x=>x.i);
 const leg=a=>h('a',{className:'leg',href:'#/a/'+a.id},a.nome);
 const n=(q,s,p)=>q+(q===1?s:p);
 trocar(
  ts.length?h('div',{className:'tags'},h('button',{className:'tag'+(tagSel?'':' on'),on:{click:()=>{tagSel='';galeria()}}},'Todas'),ts.map(t=>h('button',{className:'tag'+(tagSel===t?' on':''),on:{click:()=>{tagSel=t;galeria()}}},t))):null,
  h('div',{className:'topo'},h('button',{on:{click:()=>location.hash='#/'}},'‹ Voltar'),h('h2',null,'Todas as fotos e vídeos'),h('span',{className:'esp'}),
   h('button',{on:{click:()=>{emb=true;galeria()}}},'Embaralhar'),h('button',{on:{click:()=>{emb=false;galeria()}}},'Por atriz')),
  h('div',{className:'ctl'},
   h('div',{className:'tags'},[['todos','Tudo'],['fotos','Só fotos'],['videos','Só vídeos']].map(([k,t])=>h('button',{className:'tag'+(mostrar===k?' on':''),on:{click:()=>{mostrar=k;galeria()}}},t))),
   mostrar!=='videos'?range('Tamanho das fotos','foto',100,500):null,mostrar!=='fotos'?range('Tamanho dos vídeos','video',200,800):null,
   h('span',{className:'vazio'},n(ord.length,' foto',' fotos')+' · '+n(vids.length,' vídeo',' vídeos'))),
  ord.length?h('div',{className:'fotos'},ord.map((x,k)=>{const im=img(x.i.url);im.draggable=false;im.addEventListener('click',()=>lightbox(lista,k));
   return h('figure',{className:'it'},im,leg(x.a))})):null,
  vids.length?h('div',{className:'videos',style:'margin-top:20px'},vids.map(x=>{
   const f=h('figure',{className:'it'+(x.i.v?' vert':'')+(x.i.tw?' tw':'')},x.i.tipo==='iframe'?quadro(x.i.url):videoEl(x.i.url),leg(x.a),
    h('div',{className:'tb'},h('button',{title:'Alternar vertical e horizontal',on:{click:()=>{x.i.v=!x.i.v;salvar();f.classList.toggle('vert')}}},'Girar')));
   if(x.i.z)f.style.zoom=x.i.z;return f})):null,
  !ord.length&&!vids.length?h('p',{className:'vazio'},'Nada encontrado. Use a busca e as tags para filtrar por atriz.'):null)}
function inicio(){
 const todas=[...new Set(db.atrizes.flatMap(a=>a.tags||[]))].sort();
 if(tagSel&&!todas.includes(tagSel))tagSel='';
 const lista=db.atrizes.filter(a=>(!tagSel||(a.tags||[]).includes(tagSel))&&a.nome.toLowerCase().includes(busca.toLowerCase())).sort((a,b)=>a.nome.localeCompare(b.nome));
 trocar(
  todas.length?h('div',{className:'tags'},h('button',{className:'tag'+(tagSel?'':' on'),on:{click:()=>{tagSel='';inicio()}}},'Todas'),todas.map(t=>h('button',{className:'tag'+(tagSel===t?' on':''),on:{click:()=>{tagSel=t;inicio()}}},t))):null,
  lista.length?h('div',{className:'grade'},lista.map(card)):h('p',{className:'vazio'},db.atrizes.length?'Nenhum resultado.':'O catálogo está vazio. Clique em "Nova atriz" para começar.'))}
function card(a){const n=a.secoes.reduce((t,s)=>t+s.itens.length,0),abrir=()=>location.hash='#/a/'+a.id;
 return h('div',{className:'card',tabIndex:0,on:{click:abrir,keydown:e=>{if(e.key==='Enter'&&e.target===e.currentTarget)abrir()}}},
  h('button',{className:'x del',title:'Excluir atriz',on:{click:e=>{e.stopPropagation();if(confirm('Excluir '+a.nome+' e todo o conteúdo?')){db.atrizes=db.atrizes.filter(x=>x!==a);salvar();inicio()}}}},'✕'),
  h('div',{className:'img'},http(a.capa)?img(a.capa,a.nome):h('span',null,a.nome.slice(0,1).toUpperCase())),
  h('div',{className:'nome'},h('strong',null,a.nome),h('small',null,n+(n===1?' item':' itens'))))}
const parseTags=s=>[...new Set((s||'').split(',').map(x=>x.trim()).filter(Boolean))];
const host=u=>{try{return new URL(u).hostname.replace(/^www\./,'')}catch(e){return u}};
function sitesView(a){a.sites=a.sites||[];
 return h('div',{className:'sites'},h('strong',null,'Sites'),
  a.sites.map(x=>h('span',{className:'site'},h('a',{href:x.url,target:'_blank',rel:'noopener noreferrer',title:x.url},x.titulo),h('button',{className:'x',title:'Remover site',on:{click:()=>{a.sites=a.sites.filter(y=>y!==x);salvar();pagina(a)}}},'✕'))),
  h('button',{on:{click:()=>addSite(a)}},'+ Adicionar site'))}
async function addSite(a){const r=await form('Adicionar sites',[{k:'t',l:'Cole um ou mais links',area:1,ph:'https://...'},{k:'n',l:'Nome do site (opcional, vale quando for um link só)'}],'Adicionar');
 if(!r||!r.t)return;const ls=[...new Set((r.t.match(/https?:\/\/[^\s"'<>]+/g)||[]).map(u=>u.replace(/[).,;]+$/,'')))];
