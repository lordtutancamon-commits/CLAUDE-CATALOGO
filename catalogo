 else{m=i.tipo==='iframe'?quadro(i.url):i.tipo==='auto'?sonda(a,i):videoEl(i.url);
  if(i.tipo==='video')m.addEventListener('error',()=>m.replaceWith(h('a',{href:i.url,target:'_blank',rel:'noopener noreferrer',className:'falha'},'Vídeo não carregou. Abrir link')));
  tb.append(h('span',{className:'mv',title:'Arraste para mudar a ordem',on:{pointerdown:()=>{w.draggable=true;document.addEventListener('pointerup',()=>{w.draggable=false},{once:true})}}},'⠿ Mover'));
  tb.append(h('button',{title:'Alternar vertical e horizontal',on:{click:()=>{i.v=!i.v;salvar();w.classList.toggle('vert')}}},'Girar'))}
 tb.append(h('a',{className:'mv',href:i.url,target:'_blank',rel:'noopener noreferrer',title:'Abrir o link original'},'↗'),h('button',{className:'x',title:'Remover',on:{click:()=>{s.itens=s.itens.filter(x=>x!==i);salvar();pagina(a)}}},'✕'));
 w.draggable=i.tipo==='img';
 w.addEventListener('dragstart',e=>{arr={a,s,i};e.dataTransfer.effectAllowed='move';e.dataTransfer.setData('text/plain','');setTimeout(()=>{w.classList.add('arr');document.body.classList.add('arrastando')})});
 w.addEventListener('dragend',()=>{arr=null;w.classList.remove('arr');w.draggable=i.tipo==='img';document.body.classList.remove('arrastando');limpar()});
 w.addEventListener('dragover',e=>{if(!arr||arr.i===i)return;e.preventDefault();const r=w.getBoundingClientRect(),esq=e.clientX<r.left+r.width/2;w.classList.toggle('sobre-e',esq);w.classList.toggle('sobre-d',!esq)});
 w.addEventListener('dragleave',()=>w.classList.remove('sobre-e','sobre-d'));
 w.addEventListener('drop',e=>{if(!arr)return;e.preventDefault();e.stopPropagation();mover(arr,s,i,w.classList.contains('sobre-d'))});
 if(i.z)w.style.zoom=i.z;
 const g=h('span',{className:'rz',title:'Arraste para mudar o tamanho (duplo clique volta ao normal)'},'◢');
 g.addEventListener('pointerdown',e=>{e.preventDefault();e.stopPropagation();w.draggable=false;g.setPointerCapture(e.pointerId);
  const x0=e.clientX,r0=w.getBoundingClientRect().width,z0=i.z||1;document.body.classList.add('arrastando');
  const mv=ev=>{i.z=Math.min(4,Math.max(.3,z0*(r0+ev.clientX-x0)/r0));w.style.zoom=i.z};
  const fim=()=>{g.removeEventListener('pointermove',mv);g.removeEventListener('pointerup',fim);g.removeEventListener('pointercancel',fim);w.draggable=i.tipo==='img';document.body.classList.remove('arrastando');if(i.z)i.z=+i.z.toFixed(3);salvar()};
  g.addEventListener('pointermove',mv);g.addEventListener('pointerup',fim);g.addEventListener('pointercancel',fim)});
 g.addEventListener('dblclick',()=>{delete i.z;w.style.zoom='';salvar()});
 w.append(m,tb,g);return w}
function lightbox(l,n){if(!l.length||n<0)return;let k=n;
 const o=h('div',{className:'lb'}),im=h('img',{referrerPolicy:'no-referrer'}),c=h('span');
 const go=d=>{k=(k+d+l.length)%l.length;im.src=l[k].url;c.textContent=(k+1)+' / '+l.length};
 const fim=()=>{o.remove();document.removeEventListener('keydown',tk)};
 const tk=e=>{if(e.key==='Escape')fim();else if(e.key==='ArrowRight')go(1);else if(e.key==='ArrowLeft')go(-1)};
 o.append(im,h('button',{className:'lbp',title:'Anterior',on:{click:()=>go(-1)}},'‹'),h('button',{className:'lbn',title:'Próxima',on:{click:()=>go(1)}},'›'),h('button',{className:'lbx',title:'Fechar',on:{click:fim}},'✕'),c);
 o.addEventListener('click',e=>{if(e.target===o)fim()});document.addEventListener('keydown',tk);document.body.append(o);go(0)}
