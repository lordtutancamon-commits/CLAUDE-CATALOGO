let hlsP;const hls=()=>hlsP||(hlsP=new Promise(r=>document.head.append(h('script',{src:'https://cdn.jsdelivr.net/npm/hls.js@1',onload:r}))));
function videoEl(u){const v=h('video',{controls:true,preload:'metadata'});
 if(/\.m3u8(\?|#|$)/i.test(u)&&!v.canPlayType('application/vnd.apple.mpegurl'))hls().then(()=>{if(window.Hls){const H=new Hls();H.loadSource(u);H.attachMedia(v)}});else v.src=u;return v}
