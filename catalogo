<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Catálogo</title>
<style>
:root{--fundo:#14161a;--painel:#1d2127;--linha:#2c323b;--texto:#ece8e1;--suave:#9aa0a8;--ouro:#d9a441;--foto:220px;--video:360px}
*{box-sizing:border-box}
[hidden]{display:none!important}
.sh .seta{padding:2px 9px}
button:disabled{opacity:.35;cursor:default}
button:disabled:hover{border-color:var(--linha)}
body{margin:0;background:var(--fundo);color:var(--texto);font:15px/1.5 system-ui,"Segoe UI",sans-serif}
h1,h2,h3{font-family:"Iowan Old Style","Palatino Linotype",Georgia,serif;font-weight:600;margin:0}
button,input,textarea{font:inherit;color:inherit}
button,.bt{background:var(--painel);border:1px solid var(--linha);border-radius:6px;padding:7px 12px;cursor:pointer;display:inline-block}
button:hover,.bt:hover{border-color:var(--ouro)}
button.p{background:var(--ouro);color:#1a1405;border-color:var(--ouro);font-weight:600}
button.x{color:#e8836f}
:focus-visible{outline:2px solid var(--ouro);outline-offset:2px}
a.mv{cursor:pointer;color:inherit;text-decoration:none}
input,textarea,select{background:#101215;border:1px solid var(--linha);border-radius:6px;padding:8px 10px;width:100%}
input[type=range]{padding:0;width:140px;accent-color:var(--ouro)}
header{position:sticky;top:0;z-index:5;background:rgba(20,22,26,.94);backdrop-filter:blur(6px);border-bottom:1px solid var(--linha);padding:12px 20px;display:flex;gap:10px;align-items:center;flex-wrap:wrap}
header h1{font-size:24px;cursor:pointer;margin-right:auto}
header input[type=search]{width:220px}
main{padding:20px;max-width:1600px;margin:auto}
.tags{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
main>.tags{margin-bottom:16px}
.tag{border-radius:99px;padding:2px 11px;font-size:13px;border:1px solid var(--linha);background:var(--painel)}
.tag.on{background:var(--ouro);color:#1a1405;border-color:var(--ouro)}
.grade{display:grid;grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:16px}
.card{cursor:pointer;background:var(--painel);border:1px solid var(--linha);border-radius:8px;overflow:hidden}
.card:hover{border-color:var(--ouro)}
.card{position:relative}
.del{position:absolute;top:6px;right:6px;padding:2px 8px;font-size:12px;opacity:0;background:rgba(20,22,26,.9)}
.card:hover .del,.card:focus-within .del{opacity:1}
@media(hover:none){.del{opacity:1}}
.card .img{aspect-ratio:3/4;background:#101215;display:grid;place-items:center;font:600 56px Georgia,serif;color:var(--linha);overflow:hidden}
.card .img img{width:100%;height:100%;object-fit:cover}
.card .nome{padding:10px 12px}.card small{color:var(--suave);display:block}
.vazio{color:var(--suave)}
.falha{color:var(--suave);font-size:13px;padding:8px}
.topo{display:flex;gap:12px;align-items:center;flex-wrap:wrap;margin-bottom:12px}
.topo h2{font-size:30px}.esp{flex:1}
.ctl{display:flex;gap:18px;align-items:center;flex-wrap:wrap;margin-bottom:18px;padding:10px 0;border-block:1px solid var(--linha)}
.rg{display:flex;gap:8px;align-items:center;color:var(--suave)}
.sites{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:-6px 0 20px}
.site{display:inline-flex;align-items:center;border:1px solid var(--linha);border-radius:99px;padding:2px 4px 2px 12px;background:var(--painel)}
.site a{color:var(--texto)}
.site button{border:0;background:none;padding:0 8px}
figure.it{margin:0}
.leg{display:block;font-size:12px;color:var(--suave);text-decoration:none;margin-top:3px;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.leg:hover{color:var(--ouro)}
.sec{margin-bottom:28px}
.sh{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
.sh h3{font-size:20px;margin-right:auto;cursor:pointer}
.sh h3 small{font:13px system-ui;color:var(--suave)}
.corpo{display:grid;gap:10px}
.fotos,.videos{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start}
.it{position:relative}
.fotos .it img{height:var(--foto);width:auto;min-width:70px;max-width:100%;border-radius:6px;cursor:zoom-in;display:block;background:#101215}
.videos .it iframe,.videos .it video{width:var(--video);aspect-ratio:16/9;max-width:100%;border:0;border-radius:6px;background:#000;display:block}
.videos .tw iframe{aspect-ratio:auto!important;width:550px!important;zoom:var(--twz,1);max-width:calc((100vw - 40px)/var(--twz,1))!important;height:560px;color-scheme:dark}
.vert iframe,.vert video{aspect-ratio:9/16!important;width:calc(var(--video)*.5625)!important}
.tb{position:absolute;top:6px;right:6px;display:flex;gap:4px;opacity:0;transition:opacity .15s}
.it:hover .tb,.it:focus-within .tb{opacity:1}
@media(hover:none){.tb{opacity:1}}
.tb button,.mv{padding:2px 8px;font-size:12px;background:rgba(20,22,26,.88)}
.mv{border:1px solid var(--linha);border-radius:6px;cursor:grab;user-select:none}
.fotos .it[draggable=true]{cursor:grab}
.it.arr{opacity:.35}
.rz{position:absolute;right:3px;bottom:3px;width:20px;height:20px;line-height:18px;text-align:center;font-size:11px;cursor:nwse-resize;opacity:0;background:rgba(20,22,26,.9);border:1px solid var(--linha);border-radius:4px;user-select:none;touch-action:none;z-index:2}
.it:hover .rz,.it:focus-within .rz{opacity:1}
@media(hover:none){.rz{opacity:1}}
.sobre-e{box-shadow:-5px 0 0 var(--ouro)}
.sobre-d{box-shadow:5px 0 0 var(--ouro)}
body.arrastando iframe,body.arrastando video{pointer-events:none}
dialog.dlg{background:var(--painel);color:var(--texto);border:1px solid var(--linha);border-radius:10px;padding:20px;width:min(520px,92vw)}
dialog::backdrop{background:rgba(0,0,0,.65)}
dialog label{display:block;margin:14px 0 4px;color:var(--suave);font-size:13px}
.acoes{display:flex;justify-content:flex-end;gap:8px;margin-top:18px}
.lb{position:fixed;inset:0;background:rgba(8,9,11,.94);z-index:20;display:grid;place-items:center}
.lb img{max-width:92vw;max-height:90vh;object-fit:contain}
.lb button{position:absolute}
.lbp{left:14px;top:50%}.lbn{right:14px;top:50%}.lbx{right:14px;top:14px}
.lb span{position:absolute;bottom:14px;color:var(--suave)}
#aviso{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);width:max-content;max-width:90vw;text-align:center;background:var(--ouro);color:#1a1405;padding:8px 16px;border-radius:6px;font-weight:600;opacity:0;pointer-events:none;transition:opacity .2s;z-index:30}
#aviso.on{opacity:1}
#sinc{font-size:12px;color:var(--suave)}
</style>
</head>
<body>
<header>
<h1 onclick="location.hash='#/'">Catálogo</h1>
<input id="busca" type="search" placeholder="Buscar pelo nome" aria-label="Buscar pelo nome">
<button class="p" id="nova">Nova atriz</button>
<button id="todas" onclick="location.hash='#/fotos'">Fotos e vídeos</button>
<button id="exp">Exportar backup</button>
<label class="bt">Importar backup<input id="imp" type="file" accept="application/json" hidden></label>
<button id="env" title="Enviar o catálogo deste aparelho para o Gist">Enviar para a nuvem</button>
<button id="bai" title="Baixar o catálogo do Gist e substituir o deste aparelho">Baixar da nuvem</button>
<button id="cfgn" title="Configurar token e ID do gist" aria-label="Configurar nuvem">⚙</button>
<span id="sinc" title="Última sincronização feita neste aparelho"></span>
</header>
<main></main>
<div id="aviso" role="status"></div>
<script>
const $=s=>document.querySelector(s),K='catalogo-v1',uid=()=>Math.random().toString(36).slice(2,9),http=u=>/^https?:\/\//i.test(u||'');
let db;try{db=JSON.parse(localStorage.getItem(K))}catch(e){}
db=db&&Array.isArray(db.atrizes)?db:{atrizes:[]};db.cfg=db.cfg||{foto:220,video:360};
const salvar=()=>{try{localStorage.setItem(K,JSON.stringify(db))}catch(e){aviso('Não foi possível salvar neste navegador. Exporte um backup.')}};
const aplicar=()=>{const r=document.documentElement.style;r.setProperty('--foto',db.cfg.foto+'px');r.setProperty('--video',db.cfg.video+'px');r.setProperty('--twz',(db.cfg.video/550).toFixed(3))};
let tAviso;function aviso(t,ms){const a=$('#aviso');a.textContent=t;a.classList.add('on');clearTimeout(tAviso);tAviso=setTimeout(()=>a.classList.remove('on'),ms||2600)}
function h(t,p,...f){const e=document.createElement(t);for(const k in p||{}){const v=p[k];if(k==='on')for(const ev in v)e.addEventListener(ev,v[ev]);else if(k in e)e[k]=v;else e.setAttribute(k,v)}e.append(...f.flat().filter(x=>x!=null&&x!==false));return e}
